<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="22dp">

    <!-- Top bar -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        app:tint="?attr/colorOnSurface"
        android:contentDescription="@string/back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/topLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/now_playing"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/btnSleep" />

    <ImageButton
        android:id="@+id/btnSleep"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_sleep_timer"
        android:padding="10dp"
        app:tint="?attr/colorOnSurface"
        android:contentDescription="@string/sleep_timer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnTheme" />

    <ImageButton
        android:id="@+id/btnTheme"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_theme"
        app:tint="?attr/colorOnSurface"
        android:contentDescription="@string/theme"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Album art (flexes to fill available space, stays square) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/artCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_max="380dp"
        app:layout_constraintHeight_max="380dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toTopOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <ImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_art_big"
            android:contentDescription="@string/now_playing" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:text=""
        app:layout_constraintBottom_toTopOf="@id/artist" />

    <TextView
        android:id="@+id/artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:text=""
        app:layout_constraintBottom_toTopOf="@id/seekBar" />

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:progressTint="?attr/colorPrimary"
        android:thumbTint="?attr/colorPrimary"
        android:progressBackgroundTint="?attr/colorSurfaceVariant"
        app:layout_constraintBottom_toTopOf="@id/timeRow" />

    <LinearLayout
        android:id="@+id/timeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/abRow">

        <TextView
            android:id="@+id/position"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"
            android:text="0:00" />
        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"
            android:text="0:00" />
    </LinearLayout>

    <!-- A-B loop: mark A, mark B, loop between them -->
    <LinearLayout
        android:id="@+id/abRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@id/transport">

        <TextView
            android:id="@+id/btnSetA"
            style="@style/Chip"
            android:text="@string/ab_set_a"
            android:contentDescription="@string/ab_set_a_desc" />

        <TextView
            android:id="@+id/btnSetB"
            style="@style/Chip"
            android:text="@string/ab_set_b"
            android:contentDescription="@string/ab_set_b_desc" />

        <TextView
            android:id="@+id/abStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:text="@string/ab_off" />

        <ImageButton
            android:id="@+id/btnAbClear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@string/ab_clear" />
    </LinearLayout>

    <!-- Transport -->
    <LinearLayout
        android:id="@+id/transport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/volumeArea">

        <ImageButton
            android:id="@+id/btnShuffle"
            android:layout_width="46dp" android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_shuffle" app:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@string/shuffle" />

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="56dp" android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_prev" app:tint="?attr/colorOnSurface"
            android:contentDescription="@string/previous" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="68dp" android:layout_height="68dp"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/bg_play_fab"
            android:src="@drawable/ic_play" app:tint="?attr/colorOnPrimary"
            android:scaleType="fitCenter" android:padding="16dp"
            android:contentDescription="@string/play" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="56dp" android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_next" app:tint="?attr/colorOnSurface"
            android:contentDescription="@string/next" />

        <ImageButton
            android:id="@+id/btnRepeat"
            android:layout_width="46dp" android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_repeat" app:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@string/repeat_off" />
    </LinearLayout>

    <!-- Volume (bar or knob) -->
    <FrameLayout
        android:id="@+id/volumeArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="18dp"
        android:minHeight="64dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/volumeBarRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_volume_down" app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/volume" />
            <SeekBar
                android:id="@+id/volumeBar"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginHorizontal="10dp"
                android:progressTint="?attr/colorPrimary" android:thumbTint="?attr/colorPrimary"
                android:progressBackgroundTint="?attr/colorSurfaceVariant" />
            <ImageView
                android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_volume_up" app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/volume" />
            <ImageButton
                android:id="@+id/btnVolStyleBar"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_tune" app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/switch_volume_style" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/volumeKnobWrap"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:visibility="gone">

            <com.lull.player.VolumeKnobView
                android:id="@+id/volumeKnob"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center" />

            <ImageButton
                android:id="@+id/btnVolStyleKnob"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_tune" app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/switch_volume_style" />
        </FrameLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
